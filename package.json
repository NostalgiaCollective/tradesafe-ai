{
  "name": "tradesafe-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:staging": "node scripts/staging-integration.mjs",
    "check:staging:recovery": "node scripts/staging/recover-state.mjs",
    "test:staging:expiry": "node --use-system-ca scripts/staging/natural-expiry.mjs",
    "test:staging:ui": "node --use-system-ca scripts/staging/inspect-ui.mjs",
    "check:staging": "node scripts/staging/check.mjs",
    "staging:dev": "node scripts/staging/app.mjs",
    "staging:install-browser": "node scripts/staging/install-browser.mjs",
    "staging:prepare-expiry": "node scripts/staging/prepare-expiry.mjs",
    "test:staging:browser": "node scripts/staging/browser.mjs",
    "test:staging:browser:list": "playwright test --config=playwright.staging.config.mjs --list --reporter=list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
