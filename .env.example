APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after provider, callback origins and delivered flow are verified.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_MAGIC_LINK_ENABLED=false
# Server-only Phase 3 Storage credential. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
STAGING_ALLOW_SYNTHETIC_WRITES=no
STAGING_ISOLATED_PROJECT_REF=
STAGING_OWNER_EMAIL=
STAGING_OWNER_PASSWORD=
STAGING_WORKER_EMAIL=
STAGING_WORKER_PASSWORD=
STAGING_SUPERVISOR_EMAIL=
STAGING_SUPERVISOR_PASSWORD=
STAGING_OUTSIDER_EMAIL=
STAGING_OUTSIDER_PASSWORD=
# Password recovery: enable only after custom SMTP, template, origins and policy are verified.
# RECOVERY_EMAIL_ENABLED=yes
# Staging uses a separate ignored .staging/server.env and exact RECOVERY_ALLOWED_EMAILS list.
